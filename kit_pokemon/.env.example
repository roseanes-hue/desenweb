# Variáveis de ambiente do Kit Pokémon

# Configurações SMTP para envio de e-mail de verificação (2FA)
# Para Gmail: use "Senha de App" (não a senha normal da conta)
# Veja: https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui